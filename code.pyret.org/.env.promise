# Overlay env for running the promise/async-backend server alongside the cont one.
# Loaded via `heroku local:run -e .env,.env.promise ...` (later file wins), so the
# base .env supplies all secrets/shared config and this file overrides only the
# three knobs that differ for the promise backend. Credentials-free → committed
# (cf. .env.embed). See package.json `start-promise`.
PORT="5999"
BASE_URL="http://localhost:5999"
PYRET="http://localhost:5999/js/cpo-main-promise.jarr"
