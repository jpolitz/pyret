# Test-target override for `npm run mocha-promise`.
# .env.promise sets BASE_URL to the promise server's *public* identity (the live
# demo URL), which is correct for the running server but unreachable from the
# headless Chrome that mocha drives *inside* this VM. mocha only needs BASE_URL,
# so this overlay (loaded last, after base .env) retargets it at the LOCAL promise
# server — the same node process the public URL proxies to. Keep the port in sync
# with PORT in .env.promise. Credentials-free → committed (cf. .env.embed).
BASE_URL="http://localhost:5999"
