# Template for .env.promise — copy to `.env.promise` and adjust for your deployment:
#   cp .env.promise.example .env.promise
# (`npm run start-promise` copies it for you if .env.promise is missing.)
#
# This is an OVERLAY loaded after the base .env (`heroku local:run -e .env,.env.promise`),
# so it only lists the keys that differ for the promise/async backend. The real
# .env.promise is gitignored (like .env) because BASE_URL is deployment-specific —
# set it to your server's public URL when deploying a demo, localhost for dev.
# See package.json `start-promise`. mocha targets the LOCAL server via the separate,
# committed .env.mocha-promise, so it is decoupled from whatever BASE_URL you use here.
PORT="5999"
BASE_URL="http://localhost:5999"
PYRET="/js/cpo-main-promise.jarr"
