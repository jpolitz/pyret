DICT = deserialize-tree(WORDS-S-serialized)

# A batch of common misspellings -- each runs an edit-distance-2 BK-tree search.
queries = [list:
  "abandonned", "recieve", "occured", "seperate", "definately", "neccessary",
  "accomodate", "untill", "begining", "beleive", "calender", "concious",
  "embarass", "goverment", "harrass", "independant", "occassion", "publically",
  "recomend", "tendancy", "writting", "wierd", "yeild", "adress", "arguement",
  "commitee", "enviroment", "existance", "foriegn", "guarentee", "occurence",
  "persistant", "priviledge", "questionaire", "rememberance", "succesful",
  "threshhold", "tommorrow", "vaccuum", "withold" ]

# Drive `reps` passes over the whole batch; accumulate every result's edit
# distance so the search results can't be elided. n=2 visits a lot of the tree.
fun run(reps :: Number, acc :: Number) -> Number:
  if reps == 0: acc
  else:
    batch = for fold(t from 0, q from queries.take(12)):
      results = bk-search(DICT, q, 2)
      inner = for fold(s from 0, r from results): s + r.edit-distance end
      (t + results.length()) + inner
    end
    run(reps - 1, acc + batch)
  end
end

t0 = time-now()
final-acc = run(1, 0)
loop-ms = time-now() - t0
print(num-to-string(final-acc) + "\n")
print("LOOP-MS " + num-to-string(loop-ms) + "\n")
