>            (lambda (o)
>              (fprintf o "\\documentclass[preview]{standalone}\n")
>              (fprintf o "\\usepackage{amsmath}\n")
>              (fprintf o "\\begin{document}\n")
>              (for-each (lambda (x) (display x o) (display " " o)) latex-fragments)
