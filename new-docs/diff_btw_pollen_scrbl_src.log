< @examples{
---
> ◊example-preamble{
> import pick as P
> 
> data Queue<T>:
>   | queue(elts :: List<T>) with:
>     method pick(self):
>       cases (List) self.elts:
>         | empty => P.pick-none
>         | link(f, r) => P.pick-some(f, queue(r))
>       end
>     end
> end
> fun sum-queue(q :: Queue) -> Number:
>   cases (P.Pick) q.pick():
>     | pick-none => 0
>     | pick-some(e, r) => e + sum-queue(r)
>   end
> end
> }
> ◊examples[#:load-preamble #t]{
